.DS_Store
node_modules/
*.log

# git worktrees created under .claude/
.claude/worktrees/

# Public skills installed with the `skills` CLI — working copies, restored with
# `npx skills add stealth-factory/skills` (see AGENTS.md). Never vendored into
# git: committed copies fork the public repo silently and go stale.
#
# This repo's OWN skill symlinks live in these same two directories and ARE
# tracked — the relink loop in AGENTS.md force-adds them (`git add -f`), and git
# keeps tracking a file once added regardless of these rules.
/.agents/skills/*
/.claude/skills/*
